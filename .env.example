# Copy this file to .env and fill in values from Lovable Cloud / Supabase dashboard.
# NEVER commit the real .env file.

# Public / client-side (safe to expose in the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-side (used by server functions and SSR)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_PROJECT_ID=your-project-id

# CRITICAL: Service role key – server only. Never prefix with VITE_ or expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxx

# Public base URL used for M-Pesa callbacks (must be HTTPS in production)
# PUBLIC_APP_URL=https://codebase-migration-studio.lovable.app

# ─── Safaricom Daraja (M-Pesa) ─────────────────────────────────────────────
# Create an app at https://developer.safaricom.co.ke
# Sandbox: DARAJA_ENV=sandbox, shortcode 174379, test passkey from the portal
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=174379
# DARAJA_PASSKEY=

# Annual / card contribution amount in KES
# MEMBER_CONTRIBUTION_KES=500

# ─── Optional external National ID ↔ phone KYC provider ───────────────────
# Daraja does NOT provide phone↔ID matching. Use a commercial KYC/IPRS partner
# (Kora, Youverify, Didit, MetaMap, etc.) once you have credentials.
# IDENTITY_KYC_URL=
# IDENTITY_KYC_API_KEY=

# Digital card authorising officer (shown on the back of the ID)
# CCAK_PRESIDENT_NAME=Full Name of the National President
